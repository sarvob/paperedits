{
  "name": "paperedits",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first, prompt-driven video editor. Footage never leaves your machine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarvob/paperedits.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace @pve/core",
    "typecheck": "tsc -b",
    "doctor": "npm run doctor --workspace @pve/cli",
    "demo": "npm run demo --workspace @pve/cli",
    "repl": "npm run repl --workspace @pve/cli"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
